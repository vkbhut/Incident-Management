# Browser to run the tests on: chrome (default), edge or firefox. The window always opens maximized.
BROWSER=chrome

HEADLESS=false
# These timeouts are set in minutes
TEST_TIMEOUT=20
BROWSER_LAUNCH_TIMEOUT=0
ACTION_TIMEOUT=2
NAVIGATION_TIMEOUT=4
NETWORK_IDLE_TIMEOUT=120000      #in ms

# Execution configurations
RETRIES=0
PARALLEL_THREAD=6

# Name of the test that needs to run locally via cmd
TEST_NAME=*spec*

# IncidentReports module (TenForce QA) require below test data
INCIDENT_REPORTS_BASE_URL="https://qa-test.tenforce.info"
INCIDENT_REPORTS_USERNAME="sadmin"
INCIDENT_REPORTS_PASSWORD="qa-test!30"
